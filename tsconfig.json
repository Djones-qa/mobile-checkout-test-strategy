{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["jest", "@wdio/globals/types", "node"],
    "paths": {
      "@detox/*": ["detox/*"],
      "@appium/*": ["appium/*"],
      "@maestro/*": ["maestro/*"]
    }
  },
  "include": ["detox/**/*", "appium/**/*", "storybook/**/*"],
  "exclude": ["node_modules", "dist"]
}
