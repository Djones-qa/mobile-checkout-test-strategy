{
  "name": "mobile-checkout-test-strategy",
  "version": "1.0.0",
  "description": "Mobile E2E, cross-platform, and visual regression test suite for a React Native checkout flow",
  "scripts": {
    "detox:build:ios": "detox build --configuration ios.sim.debug",
    "detox:build:android": "detox build --configuration android.emu.debug",
    "detox:test:ios": "detox test --configuration ios.sim.debug",
    "detox:test:android": "detox test --configuration android.emu.debug",
    "appium:test": "wdio run ./appium/wdio.conf.js",
    "maestro:test": "maestro test maestro/flows/",
    "storybook": "storybook dev -p 6006",
    "percy:storybook": "percy storybook http://localhost:6006",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.4"
  },
  "devDependencies": {
    "@percy/cli": "1.28.0",
    "@percy/storybook": "5.0.0",
    "@storybook/react-native": "7.6.0",
    "@types/jest": "29.5.12",
    "@wdio/appium-service": "8.36.0",
    "@wdio/cli": "8.36.0",
    "@wdio/jasmine-framework": "8.36.0",
    "@wdio/local-runner": "8.36.0",
    "@wdio/spec-reporter": "8.36.0",
    "appium": "2.5.1",
    "appium-uiautomator2-driver": "3.0.0",
    "appium-xcuitest-driver": "7.0.0",
    "detox": "20.18.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "typescript": "5.4.5",
    "webdriverio": "8.36.0"
  }
}
